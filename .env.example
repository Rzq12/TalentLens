# TalentLens — environment template (Phase 0-3)
# Copy to `.env` and fill in. Never commit a populated `.env`.
#
# Every key below maps to a field on `Settings` in serving/app/config.py, and
# tests/unit/test_docs_sync.py fails if the two drift apart in either direction.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development           # development | test | production
LOG_LEVEL=INFO

# --- Database (required, no default — the app fails fast without it) ---------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talentlens
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Authentication (required, no default) -----------------------------------
# Supplied by Supabase Auth in deployment. Use >=32 bytes in production.
JWT_SECRET=
JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
# Symmetric only. Widening this to an asymmetric family without also supplying
# the matching key material makes every token fail to verify.
JWT_ALGORITHMS=["HS256"]

# --- Object storage ----------------------------------------------------------
STORAGE_BACKEND=memory            # memory | supabase
STORAGE_BUCKET=resumes
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Upload limits -----------------------------------------------------------
MAX_UPLOAD_BYTES=10485760         # 10 MiB
# Enforced against the magic bytes of the upload, not the filename. Adding a
# type here without a parser that handles it produces a 500 on first upload.
ALLOWED_UPLOAD_MIME_TYPES=["application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]

# --- CORS (Vite dev server by default; add the Vercel origin in production) --
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- Embedding (Phase 2) ----------------------------------------------------
# HuggingFace Text Embeddings Inference endpoint for bge-m3
EMBEDDING_ENDPOINT=http://localhost:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
# Max child chunks embedded per document. Embedding runs inline in the upload
# request while a DB connection is held, so this bounds how long one oversized
# document can occupy the pool. Excess children are dropped with a warning.
INDEXING_MAX_CHILD_CHUNKS=600

# --- Search (Phase 2) -------------------------------------------------------
SEARCH_DENSE_WEIGHT=0.6
SEARCH_LEXICAL_WEIGHT=0.4
SEARCH_TOP_K_RECALL=20
SEARCH_RERANK_TOP_K=10

# --- Reranker (Phase 2, optional) --------------------------------------------
# Leave empty to disable reranking (CPU fallback / dev mode)
RERANKER_ENDPOINT=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM providers (Phase 4) --------------------------------------------------
# Free-tier keys for the judge chain. Leave both empty to boot without provider
# access: the deterministic test suite mocks the transport and never needs them.
# Real values belong in .env only, which is gitignored — never in this file.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Model ids live in config, not in code, so a free-tier deprecation is a config
# change. Both providers are cloud, so both are limited to PII tiers T0 and T1;
# a full-PII (T2) request is routed to a dedicated endpoint instead.
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Pinned at zero. Sampling would make the same candidate score differently on a
# re-run, which is not defensible in a hiring decision.
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_OUTPUT_TOKENS=2048
